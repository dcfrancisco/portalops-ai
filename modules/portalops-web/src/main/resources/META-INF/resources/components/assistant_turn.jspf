<%
String assistantTurnPrompt =
    (String)request.getAttribute("PORTALOPS_ASSISTANT_TURN_PROMPT");
PortalOpsAssistantResponse<? extends AssistantPayload> assistantTurnResponse =
    (PortalOpsAssistantResponse<? extends AssistantPayload>)request.getAttribute(
        "PORTALOPS_ASSISTANT_TURN_RESPONSE");
String assistantTurnSummary = assistantTurnResponse.getSummary().stripIndent();
%>

<section class="portalops-assistant-turn">
  <div class="portalops-chat-message portalops-chat-message-user">
    <div class="portalops-chat-user-bubble"><%= HtmlUtil.escape(assistantTurnPrompt) %></div>
  </div>

  <div class="portalops-chat-message portalops-chat-message-assistant">
    <div class="portalops-assistant-response-copy portalops-assistant-response-<%= assistantTurnResponse.getStatus().name().toLowerCase() %>"><%= HtmlUtil.escape(assistantTurnSummary) %></div>
  </div>
</section>

<%
PortalOpsAssistantInsight assistantInsight = assistantData.getInsight();
%>

<section class="portalops-assistant-insight">
  <% if ((assistantTurns != null) && !assistantTurns.isEmpty()) { %>
    <% for (PortalOpsAssistantConversationTurn assistantTurn : assistantTurns) {
         request.setAttribute(
             "PORTALOPS_ASSISTANT_TURN_PROMPT", assistantTurn.getPrompt());
         request.setAttribute(
             "PORTALOPS_ASSISTANT_TURN_RESPONSE",
             assistantTurn.getPortalOpsAssistantResponse());
    %>
      <%@ include file="/components/assistant_turn.jspf" %>
    <% } %>
  <% } else if (assistantResponse != null) { %>
    <%
    request.setAttribute("PORTALOPS_ASSISTANT_TURN_PROMPT", assistantPromptValue);
    request.setAttribute("PORTALOPS_ASSISTANT_TURN_RESPONSE", assistantResponse);
    %>
    <%@ include file="/components/assistant_turn.jspf" %>
  <% } else { %>
    <div class="portalops-assistant-status">
      <span class="portalops-metric-label"><%= HtmlUtil.escape(assistantInsight.getTitle()) %></span>
      <span class="portalops-status-badge portalops-status-badge-neutral">
        <%= HtmlUtil.escape(assistantInsight.getStatus()) %>
      </span>
    </div>

    <div class="portalops-assistant-list-block">
      <div class="portalops-metric-label">Findings</div>
      <ul class="portalops-list portalops-assistant-list">
        <% for (String finding : assistantInsight.getFindings()) { %>
          <li><%= HtmlUtil.escape(finding) %></li>
        <% } %>
      </ul>
    </div>

    <div class="portalops-assistant-list-block">
      <div class="portalops-metric-label">Recommendations</div>
      <ul class="portalops-list portalops-assistant-list">
        <% for (String recommendation : assistantInsight.getRecommendations()) { %>
          <li><%= HtmlUtil.escape(recommendation) %></li>
        <% } %>
      </ul>
    </div>
  <% } %>
</section>

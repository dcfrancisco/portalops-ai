<%
PortalOpsAssistantData assistantData = dashboardData.getAssistantData();
String assistantInputId =
    renderResponse.getNamespace() + "portalOpsAssistantPrompt";
String contextTabsId =
    renderResponse.getNamespace() + "portalOpsContextTabs";
String assistantFormId =
    renderResponse.getNamespace() + "portalOpsAssistantForm";
%>

<div class="portalops-context-shell">
  <section class="card portalops-context-card portalops-context-tabs-card" id="<%= HtmlUtil.escapeAttribute(contextTabsId) %>">
    <div class="card-body portalops-context-tabs-body">
      <div class="portalops-context-tabs-header" role="tablist" aria-label="PortalOps context tabs">
        <button
          aria-selected="true"
          class="portalops-context-tab is-active"
          data-tab-target="portalops"
          role="tab"
          type="button"
        >
          PortalOps
        </button>
        <button
          aria-selected="false"
          class="portalops-context-tab"
          data-tab-target="findings"
          role="tab"
          type="button"
        >
          Findings
        </button>
        <button
          aria-selected="false"
          class="portalops-context-tab"
          data-tab-target="actions"
          role="tab"
          type="button"
        >
          Actions
        </button>
      </div>

      <div class="portalops-context-tab-panels">
        <section class="portalops-context-tab-panel portalops-context-tab-panel-assistant is-active" data-tab-panel="portalops" role="tabpanel">
          <div class="portalops-context-assistant-response">
            <% if (assistantResponse != null) { %>
              <%@ include file="/components/assistant_insight_card.jspf" %>
            <% } %>
          </div>

          <portlet:renderURL var="portalOpsAssistantURL">
            <portlet:param name="screen" value="<%= viewData.getActiveScreen() %>" />
          </portlet:renderURL>

          <div class="portalops-context-assistant-composer">
            <form action="<%= portalOpsAssistantURL %>" id="<%= HtmlUtil.escapeAttribute(assistantFormId) %>" method="get">
              <input name="<portlet:namespace />assistantMode" type="hidden" value="prompt" />
              <input name="<portlet:namespace />screen" type="hidden" value="<%= HtmlUtil.escapeAttribute(viewData.getActiveScreen()) %>" />

              <div class="portalops-assistant-prompt-row portalops-chat-composer-row">
                <textarea
                  class="form-control portalops-chat-input"
                  id="<%= HtmlUtil.escapeAttribute(assistantInputId) %>"
                  name="<portlet:namespace />assistantPrompt"
                  placeholder="<%= HtmlUtil.escapeAttribute(assistantData.getPlaceholder()) %>"
                  rows="1"
                ><%= HtmlUtil.escape(assistantResponse == null && assistantPromptValue != null ? assistantPromptValue : "") %></textarea>

                <button aria-label="Send prompt" class="btn btn-primary portalops-context-submit" type="submit">
                  <svg aria-hidden="true" class="portalops-send-icon" viewBox="0 0 16 16">
                    <path d="M13.78 2.22a.75.75 0 0 0-.77-.18L2.86 5.73a.75.75 0 0 0 .06 1.42l4.12 1.17 1.17 4.12a.75.75 0 0 0 1.42.06l3.69-10.15a.75.75 0 0 0-.18-.77Zm-4.37 8.07-.79-2.77a.75.75 0 0 0-.51-.51l-2.77-.79 6.4-2.33-2.33 6.4Z" fill="currentColor" />
                  </svg>
                </button>
              </div>
            </form>
          </div>
        </section>

        <section class="portalops-context-tab-panel portalops-context-tab-panel-scrollable" data-tab-panel="findings" role="tabpanel" hidden>
          <% if ((analysisResponse != null) && !analysisResponse.getFindingCards().isEmpty()) { %>
            <dl class="portalops-findings-list">
              <% for (FindingCard findingCard : analysisResponse.getFindingCards()) { %>
                <div class="portalops-finding-row">
                  <dt><%= HtmlUtil.escape(findingCard.getTitle()) %></dt>
                  <dd><%= HtmlUtil.escape(findingCard.getValue()) %></dd>
                </div>
              <% } %>
            </dl>
          <% } %>
        </section>

        <section class="portalops-context-tab-panel portalops-context-tab-panel-scrollable" data-tab-panel="actions" role="tabpanel" hidden>
          <div class="portalops-context-actions">
            <% if ((analysisResponse != null) && !analysisResponse.getRecommendations().isEmpty()) { %>
              <% for (Recommendation recommendation : analysisResponse.getRecommendations()) { %>
                <div class="portalops-action-row">
                  <div class="portalops-insight-title"><%= HtmlUtil.escape(recommendation.getTitle()) %></div>
                  <div class="portalops-metric-help"><%= HtmlUtil.escape(recommendation.getDescription()) %></div>
                </div>
              <% } %>
            <% } %>

            <% if ((analysisResponse != null) && !analysisResponse.getActionLinks().isEmpty()) { %>
              <% for (ActionLink actionLink : analysisResponse.getActionLinks()) {
                   request.setAttribute("PORTALOPS_ACTION_LINK", actionLink);
              %>
                <%@ include file="/components/action_card.jspf" %>
              <% } %>
            <% } %>
          </div>
        </section>
      </div>
    </div>
  </section>
</div>

<script>
  (function() {
    var cardId = '<%= HtmlUtil.escapeJS(contextTabsId) %>';
    var formId = '<%= HtmlUtil.escapeJS(assistantFormId) %>';
    var promptId = '<%= HtmlUtil.escapeJS(assistantInputId) %>';

    window.PortalOpsInitContextPanel = function(root) {
      if (!root) {
        return;
      }

      var tabsRoot = root.querySelector('#' + CSS.escape(cardId));
      var form = root.querySelector('#' + CSS.escape(formId));
      var promptInput = root.querySelector('#' + CSS.escape(promptId));

      if (tabsRoot) {
        var tabs = tabsRoot.querySelectorAll('[data-tab-target]');
        var panels = tabsRoot.querySelectorAll('[data-tab-panel]');

        tabs.forEach(function(tab) {
          if (tab.dataset.bound === 'true') {
            return;
          }

          tab.dataset.bound = 'true';

          tab.addEventListener('click', function() {
            var target = tab.getAttribute('data-tab-target');

            tabs.forEach(function(item) {
              var active = item === tab;
              item.classList.toggle('is-active', active);
              item.setAttribute('aria-selected', String(active));
            });

            panels.forEach(function(panel) {
              var active = panel.getAttribute('data-tab-panel') === target;
              panel.classList.toggle('is-active', active);
              panel.hidden = !active;
            });
          });
        });
      }

      if (!form || !promptInput || (form.dataset.bound === 'true')) {
        return;
      }

      form.dataset.bound = 'true';

      function resizePromptInput() {
        promptInput.style.height = 'auto';
        promptInput.style.height = Math.min(promptInput.scrollHeight, 128) + 'px';
      }

      promptInput.addEventListener('input', resizePromptInput);
      promptInput.addEventListener('keydown', function(event) {
        if ((event.key === 'Enter') && !event.shiftKey) {
          event.preventDefault();

          if (promptInput.value.trim()) {
            form.requestSubmit();
          }
        }
      });

      resizePromptInput();

      form.addEventListener('submit', function(event) {
        event.preventDefault();

        var submitButton = form.querySelector('button[type="submit"]');
        var formData = new FormData(form);
        var searchParams = new URLSearchParams();

        formData.forEach(function(value, key) {
          searchParams.append(key, value);
        });

        if (submitButton) {
          submitButton.disabled = true;
        }

        fetch(form.action + '?' + searchParams.toString(), {
          credentials: 'same-origin',
          headers: {
            'X-Requested-With': 'XMLHttpRequest'
          },
          method: 'GET'
        })
          .then(function(response) {
            return response.text();
          })
          .then(function(html) {
            var parser = new DOMParser();
            var doc = parser.parseFromString(html, 'text/html');
            var currentCard = root.querySelector('#' + CSS.escape(cardId));
            var replacementCard = doc.getElementById(cardId);

            if (!currentCard || !replacementCard) {
              window.location.href = form.action + '?' + searchParams.toString();
              return;
            }

            var currentRoot = currentCard.closest('.portalops-context-shell');
            var replacementRoot = replacementCard.closest('.portalops-context-shell');

            if (!currentRoot || !replacementRoot) {
              window.location.href = form.action + '?' + searchParams.toString();
              return;
            }

            currentRoot.replaceWith(replacementRoot);
            window.PortalOpsInitContextPanel(replacementRoot);

            var responseArea = replacementRoot.querySelector('.portalops-context-assistant-response');

            if (responseArea) {
              responseArea.scrollTop = responseArea.scrollHeight;
            }
          })
          .catch(function() {
            window.location.href = form.action + '?' + searchParams.toString();
          })
          .finally(function() {
            if (submitButton) {
              submitButton.disabled = false;
            }
          });
      });
    };

    var initialCard = document.getElementById(cardId);

    if (initialCard) {
      window.PortalOpsInitContextPanel(
        initialCard.closest('.portalops-context-shell')
      );
    }
  })();
</script>
